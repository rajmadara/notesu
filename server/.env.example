# Copy this file to server/.env and fill in your values.
# server/.env is gitignored - never commit real secrets.

# Anthropic API key, for AI note formatting. Get one at https://platform.claude.com/ -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase Postgres connection string. Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres

# Supabase project URL + anon public key, for verifying signed-in users' tokens.
# Project Settings -> API.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
