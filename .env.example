# Copy this file to .env (repo root) and fill in your values.
# .env is gitignored - never commit real secrets.
# Vite loads this automatically for local dev; Vercel gets its own copies
# of these set as project environment variables in its dashboard.

# Supabase project URL + anon public key. Project Settings -> API.
# Required - the app throws on startup if these are missing.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the Express API. Leave unset for local dev (falls back to
# localhost:3001); set to the deployed backend's URL in production.
# VITE_API_URL=https://notesu.onrender.com
